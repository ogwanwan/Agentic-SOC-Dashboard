# 제외 파일 설정에 대한 자세한 내용: https://help.github.com/articles/ignoring-files/

# 의존성
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 테스트 결과
/coverage

# Next.js
/.next/
/.vinext/
/out/

# 운영체제 및 인증서 파일
.DS_Store
*.pem

# 디버그 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 환경 변수 파일(필요하면 명시적으로 추적 가능)
.env*
!.env.example

# Python 가상환경과 SSOC 전용 실행 도구
/.venv/
/.ssoc-runtime/
__pycache__/
*.py[cod]

# Vercel
.vercel

# TypeScript
next-env.d.ts
/dist/
/.wrangler/
# 현재 체크아웃에서만 사용하는 실행 프로필과 도구 상태이므로 배포하지 않습니다.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# 로컬 Sites 배포 묶음
/ssoc-dashboard-site.tar.gz

*.tmp
node_modules/
.next/
.env
/soc.db
/soc.db-shm
/soc.db-wal
/results/
